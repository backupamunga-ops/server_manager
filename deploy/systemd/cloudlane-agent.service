[Unit]
Description=Cloudlane Go Agent
After=docker.service
Requires=docker.service
After=cloudlane-api.service

[Service]
Type=simple
User=root
EnvironmentFile=/etc/cloudlane/agent.env
ExecStartPre=/bin/mkdir -p /run/cloudlane
ExecStart=/usr/local/bin/cloudlane-agent \
  --socket /run/cloudlane/agent.sock \
  --hmac-key-file /etc/cloudlane/agent-hmac.key \
  --instance-id ${INSTANCE_ID}
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
