// Cloudlane Prisma schema — Phase 1 + Phase 2
// Matches docs/PHASE_1_2_BUILD_PLAN.md section 3.
// Phase 3+ entities (domain_zones, mailboxes, cron_schedules, storage_buckets)
// will be added in their phases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ Installation & Identity ============

model InstallationIdentity {
  id              String   @id @default(uuid())
  instanceId      String   @unique
  version         String
  createdAt       DateTime @default(now())
  claimedAt       DateTime?
  publicKey       String
  encryptedSecret String
  schemaVersion   Int      @default(1)
  claim           InstallationClaim?
}

enum ClaimStatus {
  UNCLAIMED
  CLAIM_ISSUED
  CLAIM_VERIFIED
  CLAIM_CONSUMED
  CLAIM_EXPIRED
}

model InstallationClaim {
  id              String      @id @default(uuid())
  installationId  String      @unique
  claimHash       String      @unique
  status          ClaimStatus @default(CLAIM_ISSUED)
  issuedAt        DateTime    @default(now())
  expiresAt       DateTime
  consumedAt      DateTime?
  attemptCount    Int         @default(0)
  maxAttempts     Int         @default(5)
  installation    InstallationIdentity @relation(fields: [installationId], references: [id])
}

// ============ Users & Auth ============

enum UserRole {
  OWNER
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  role            UserRole @default(OWNER)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lastLoginAt     DateTime?
  password        PasswordCredential?
  mfaFactors      MfaFactor[]
  recoveryCodes   RecoveryCodeHash[]
  sessions        Session[]
  apiKeys         ApiKey[]
  auditEvents     AuditEvent[]
  ownedWorkspaces Workspace[]
}

model PasswordCredential {
  userId          String   @id
  argon2Hash      String
  pepperVersion   Int
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id])
}

enum MfaType {
  TOTP
}

model MfaFactor {
  id              String   @id @default(uuid())
  userId          String
  type            MfaType
  encryptedSecret String
  enabledAt       DateTime?
  verifiedAt      DateTime?
  user            User     @relation(fields: [userId], references: [id])
}

model RecoveryCodeHash {
  id              String   @id @default(uuid())
  userId          String
  codeHash        String
  usedAt          DateTime?
  user            User     @relation(fields: [userId], references: [id])
}

model Session {
  id              String   @id @default(uuid())
  userId          String
  handleHash      String   @unique
  csrfToken       String
  createdAt       DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  expiresAt       DateTime
  ip              String?
  userAgent       String?
  revokedAt       DateTime?
  requiresStepUp  Boolean  @default(false)
  stepUpExpiresAt DateTime?
  user            User     @relation(fields: [userId], references: [id])
}

model ApiKey {
  id              String   @id @default(uuid())
  userId          String
  name            String
  keyHash         String   @unique
  last4           String
  scopes          String[]
  createdAt       DateTime @default(now())
  revokedAt       DateTime?
  expiresAt       DateTime?
  user            User     @relation(fields: [userId], references: [id])
}

// ============ Workspace & Projects ============

model Workspace {
  id              String   @id @default(uuid())
  name            String
  ownerId         String   @unique
  createdAt       DateTime @default(now())
  owner           User     @relation(fields: [ownerId], references: [id])
  githubConnected Boolean  @default(false)
  projects        Project[]
  domains         Domain[]
  domainZones     DomainZone[]
  activities      ActivityItem[]
  serviceLinks    ServiceLink[]
  buckets         Bucket[]
  storageObjects  StorageObject[]
  storageGrants   StorageGrant[]
}

model Project {
  id              String   @id @default(uuid())
  workspaceId     String
  slug            String
  name            String
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  workspace       Workspace @relation(fields: [workspaceId], references: [id])
  environments    Environment[]
  services        Service[]
  @@unique([workspaceId, slug])
}

enum EnvironmentName {
  production
}

model Environment {
  id              String   @id @default(uuid())
  projectId       String
  name            EnvironmentName @default(production)
  createdAt       DateTime @default(now())
  project         Project  @relation(fields: [projectId], references: [id])
  services        Service[]
  @@unique([projectId, name])
}

// ============ Services & Deployments ============

enum ServiceKind {
  application
  database
  cron
  storage
}

enum ServiceRole {
  web
  api
  worker
  static
}

enum ServiceSource {
  zip
  github
}

model Service {
  id              String   @id @default(uuid())
  projectId       String
  environmentId   String
  name            String
  kind            ServiceKind @default(application)
  role            ServiceRole
  source          ServiceSource
  framework       String
  env             String   @default("production")
  desiredState    String   @default("running")
  observedState   String   @default("pending")
  observedAt      DateTime?
  activeDeploymentId String? @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  project         Project  @relation(fields: [projectId], references: [id])
  environment     Environment @relation(fields: [environmentId], references: [id])
  deployments     Deployment[]
  variables       ServiceVariable[]
  githubLink      GithubInstallation?
  zipSource       ZipSource?
  volumes         PersistentVolume[]
  activeDeployment Deployment? @relation("ActiveDeployment", fields: [activeDeploymentId], references: [id])
  // Cloudlane prototype resource fields (scaffold layer)
  repoFullName     String?
  branch           String?
  autoDeploy       Boolean?
  fileName         String?
  engine           String?
  engineVersion    String?
  databaseName     String?
  external         Boolean?
  allowedIp        String?
  passwordCipher   String?
  method           String?
  targetUrl        String?
  schedule         String?
  timezone         String?
  enabled          Boolean?
  provider         String?
  dbUsers          DbUser[]
  dbBackups        DbBackup[]
  cronRuns         CronRun[]
  buckets          Bucket[]
  storageGrants    StorageGrant[]
  serviceLinksFrom ServiceLink[] @relation("LinkFrom")
  serviceLinksTo   ServiceLink[] @relation("LinkTo")
  @@unique([projectId, name])
}

model ServiceVariable {
  id              String   @id @default(uuid())
  serviceId       String
  key             String
  encryptedValue  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  service         Service  @relation(fields: [serviceId], references: [id])
  @@unique([serviceId, key])
}

model ZipSource {
  serviceId       String   @id
  storagePath     String
  sha256          String
  fileSize        BigInt
  entryCount      Int
  detectedFramework String
  createdAt       DateTime @default(now())
  service         Service  @relation(fields: [serviceId], references: [id])
}

model GithubInstallation {
  serviceId       String   @id
  installationId  Int
  repoFullName    String
  branch          String   @default("main")
  autoDeploy      Boolean  @default(true)
  lastRevision    String?
  createdAt       DateTime @default(now())
  service         Service  @relation(fields: [serviceId], references: [id])
}

enum DeploymentStatus {
  REQUESTED
  QUEUED
  FETCHING
  VALIDATING
  DETECTING
  BUILDING
  STARTING_CANDIDATE
  HEALTH_CHECKING
  ACTIVATING
  LIVE
  SUPERSEDED
  FAILED
  CANCELLED
  TIMED_OUT
  ROLLED_BACK
}

model Deployment {
  id              String   @id @default(uuid())
  serviceId       String
  status          DeploymentStatus @default(REQUESTED)
  stage           Int      @default(0)
  revision        String
  imageDigest     String?
  errorMessage    String?
  startedAt       DateTime @default(now())
  finishedAt      DateTime?
  previousDeploymentId String?
  service         Service  @relation(fields: [serviceId], references: [id])
  activeFor       Service? @relation("ActiveDeployment")
  events          DeploymentEvent[]
  @@index([serviceId, startedAt])
}

enum DeploymentEventLevel {
  info
  success
  warning
  error
}

model DeploymentEvent {
  id              String   @id @default(uuid())
  deploymentId    String
  stage           DeploymentStatus
  level           DeploymentEventLevel
  message         String
  createdAt       DateTime @default(now())
  deployment      Deployment @relation(fields: [deploymentId], references: [id])
  @@index([deploymentId, createdAt])
}

// ============ Persistent Volumes ============

model PersistentVolume {
  id              String   @id @default(uuid())
  serviceId       String
  name            String
  mountPath       String
  quotaMB         Int
  createdAt       DateTime @default(now())
  service         Service  @relation(fields: [serviceId], references: [id])
  @@unique([serviceId, name])
}

// ============ Audit & Operations ============

enum AuditAction {
  DB_ADMIN_OPEN
  CLAIM_ISSUED
  CLAIM_VERIFIED
  CLAIM_FAILED
  OWNER_CREATED
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  MFA_ENROLLED
  MFA_VERIFIED
  RECOVERY_CODE_USED
  SESSION_REVOKED
  API_KEY_CREATED
  API_KEY_REVOKED
  PROJECT_CREATED
  PROJECT_DELETED
  SERVICE_CREATED
  DEPLOYMENT_STARTED
  DEPLOYMENT_LIVE
  DEPLOYMENT_FAILED
  DEPLOYMENT_ROLLED_BACK
  VARIABLE_ADDED
  VARIABLE_REMOVED
  SERVICE_VARIABLE_SET
  SERVICE_VARIABLE_DELETED
  AGENT_COMMAND_SENT
  AGENT_COMMAND_REJECTED
  DOMAIN_ADDED
  DOMAIN_VERIFIED
  DOMAIN_VERIFY_FAILED
  DOMAIN_DNS_MODE_SET
  DOMAIN_REMOVED
  SERVICE_FILE_UPDATED
  SERVICE_FILE_UPLOADED
  SERVICE_FILE_DELETED
  SERVICE_FILE_RENAMED
  SERVICE_FILE_COPIED
  SERVICE_FILES_EXTRACTED
  SERVICE_SOURCE_REPLACED
  SERVICE_RESTARTED
}

model AuditEvent {
  id              String   @id @default(uuid())
  actorUserId     String?
  actorType       String
  workspaceId     String?
  resourceType    String?
  resourceId      String?
  action          AuditAction
  status          String
  ipAddress       String?
  correlationId   String?
  metadata        Json?
  createdAt       DateTime @default(now())
  user            User?    @relation(fields: [actorUserId], references: [id])
  @@index([action, createdAt])
  @@index([resourceType, resourceId])
}

enum OperationStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model Operation {
  id              String   @id @default(uuid())
  idempotencyKey  String   @unique
  resourceType    String
  resourceId      String
  operationType   String
  status          OperationStatus @default(QUEUED)
  attempts        Int      @default(0)
  maxAttempts     Int      @default(3)
  lastError       String?
  payload         Json
  createdAt       DateTime @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  @@index([resourceType, resourceId, status])
}

enum DomainStatus {
  PENDING
  VERIFIED
  FAILED
}

enum DomainDnsMode {
  MANUAL
  MANAGED
}

/// Custom domain attached to the workspace (master guide section 06).
/// One-field Add Domain; DNS mode changes only under domain Settings.
model Domain {
  id                String        @id @default(uuid())
  workspaceId       String
  host              String        @unique
  status            DomainStatus  @default(PENDING)
  dnsMode           DomainDnsMode @default(MANUAL)
  verificationToken String        @unique
  verifiedAt        DateTime?
  lastCheckedAt     DateTime?
  lastError         String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  workspace         Workspace     @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
}


// ─── Cloudlane domain registry (prototype v1.4+) ───

model DomainZone {
  id             String   @id @default(uuid())
  workspaceId    String
  name           String
  status         String   @default("pending")
  dnsMode        String   @default("manual")
  pendingDnsMode String?
  delegation     String?
  createdAt      DateTime @default(now())
  workspace      Workspace @relation(fields: [workspaceId], references: [id])
  hostnames      Hostname[]
  dnsRecords     DnsRecord[]
  mailboxes      Mailbox[]
  mailAliases    MailAlias[]
  @@unique([workspaceId, name])
}

model Hostname {
  id        String   @id @default(uuid())
  zoneId    String
  name      String   @unique
  type      String
  serviceId String?
  createdAt DateTime @default(now())
  zone      DomainZone @relation(fields: [zoneId], references: [id])
}

model DnsRecord {
  id       String  @id @default(uuid())
  zoneId   String
  type     String
  name     String
  value    String
  ttl      Int     @default(3600)
  priority Int?
  zone     DomainZone @relation(fields: [zoneId], references: [id])
  @@index([zoneId])
}

model Mailbox {
  id        String   @id @default(uuid())
  zoneId    String
  local     String
  quota     Int      @default(100)
  status    String   @default("active")
  createdAt DateTime @default(now())
  zone      DomainZone @relation(fields: [zoneId], references: [id])
  @@index([zoneId])
}

model MailAlias {
  id        String   @id @default(uuid())
  zoneId    String
  local     String
  target    String
  createdAt DateTime @default(now())
  zone      DomainZone @relation(fields: [zoneId], references: [id])
  @@index([zoneId])
}

// ─── Database pipeline resources ───

model DbUser {
  id          String   @id @default(uuid())
  serviceId   String
  username    String
  privileges  String[]
  revoked     Boolean  @default(false)
  passwordCipher String
  createdAt   DateTime @default(now())
  service     Service  @relation(fields: [serviceId], references: [id])
  @@unique([serviceId, username])
}

model DbBackup {
  id        String   @id @default(uuid())
  serviceId String
  status    String   @default("success")
  createdAt DateTime @default(now())
  service   Service  @relation(fields: [serviceId], references: [id])
  @@index([serviceId])
}

model CronRun {
  id        String   @id @default(uuid())
  serviceId String
  status    String
  code      String?
  durationMs String?
  createdAt DateTime @default(now())
  service   Service  @relation(fields: [serviceId], references: [id])
  @@index([serviceId, createdAt])
}

// ─── Object storage resources ───

model Bucket {
  id               String   @id @default(uuid())
  workspaceId      String
  storageServiceId String
  name             String   @unique
  privacy          String   @default("private")
  purpose          String?
  maxMB            Int      @default(500)
  createdAt        DateTime @default(now())
  workspace        Workspace @relation(fields: [workspaceId], references: [id])
  service          Service  @relation(fields: [storageServiceId], references: [id])
  objects          StorageObject[]
  grants           StorageGrant[]
}

model StorageObject {
  id        String   @id @default(uuid())
  workspaceId String
  bucketId  String
  key       String
  size      Int      @default(0)
  type      String
  isFolder  Boolean  @default(false)
  createdAt DateTime @default(now())
  bucket    Bucket   @relation(fields: [bucketId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id])
  @@unique([bucketId, key])
}

model StorageGrant {
  id               String   @id @default(uuid())
  workspaceId      String
  storageServiceId String
  bucketId         String
  serviceId        String
  scope            String
  createdAt        DateTime @default(now())
  workspace        Workspace @relation(fields: [workspaceId], references: [id])
  service          Service  @relation(fields: [storageServiceId], references: [id])
  bucket           Bucket   @relation(fields: [bucketId], references: [id])
}

// ─── Activity feed + visual links ───

model ActivityItem {
  id          String   @id @default(uuid())
  workspaceId String
  title       String
  detail      String?
  type        String   @default("system")
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  @@index([workspaceId, createdAt])
}

model ServiceLink {
  id        String   @id @default(uuid())
  workspaceId String
  fromServiceId String
  toServiceId   String
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id])
  fromService Service @relation("LinkFrom", fields: [fromServiceId], references: [id])
  toService   Service @relation("LinkTo", fields: [toServiceId], references: [id])
}

// ─── Mail (internal delivery; external SMTP is on the mail-stack roadmap) ───

model MailMessage {
  id           Int      @id @default(autoincrement())
  workspaceId  String
  accountEmail String
  folder       String   @default("inbox")
  fromName     String   @default("")
  fromEmail    String   @default("")
  toEmail      String   @default("")
  subject      String   @default("")
  body         String   @default("")
  snippet      String   @default("")
  labels       String   @default("[]")
  attachments  String   @default("[]")
  thread       String   @default("[]")
  priority     Boolean  @default(false)
  unread       Boolean  @default(true)
  starred      Boolean  @default(false)
  createdAt    DateTime @default(now())
  @@index([workspaceId, accountEmail, folder])
}
