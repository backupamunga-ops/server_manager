# Cloudlane API environment variables
# Copy to .env and fill in real values. NEVER commit .env.

# Database
DATABASE_URL="postgresql://cloudlane:CHANGE_ME@localhost:5432/cloudlane?schema=public"

# Server
PORT=3000
NODE_ENV=development
# In production, the API listens on a UNIX socket proxied by Caddy
# LISTEN_SOCKET=/run/cloudlane/api.sock

# Installation
# Generated by the installer. Leave empty in dev — first run will create.
INSTANCE_ID=
INSTALLER_VERSION=0.1.0

# Security
# Master encryption key for envelope encryption (32 bytes hex).
# Generate with: openssl rand -hex 32
MASTER_KEY=
# Pepper added to password hashes (rotate by incrementing PEPPER_VERSION)
PASSWORD_PEPPER=
PEPPER_VERSION=1

# Session
SESSION_COOKIE_NAME=cloudlane_session
SESSION_TTL_MINUTES=10080
SESSION_STEPUP_TTL_MINUTES=5

# Claim
CLAIM_TTL_MINUTES=20
CLAIM_MAX_ATTEMPTS=5

# Rate limits
LOGIN_RATE_LIMIT_PER_MINUTE=10
CLAIM_RATE_LIMIT_PER_MINUTE=5

# GitHub App (Phase 3)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=/etc/cloudlane/github-app.private-key.pem
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Agent IPC
AGENT_SOCKET_PATH=/run/cloudlane/agent.sock
AGENT_HMAC_KEY=

# Garage S3 (for uploads and deployment artifacts)
S3_ENDPOINT=http://127.0.0.1:3900
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_UPLOADS=cloudlane-uploads
S3_BUCKET_DEPLOYMENTS=cloudlane-deployments
S3_REGION=garage

# DeepSeek (Phase 5)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# CORS (in production, same-origin — empty means no CORS)
CORS_ORIGIN=

# Logging
LOG_LEVEL=info
