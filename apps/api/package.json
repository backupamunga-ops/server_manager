{
  "name": "@cloudlane/api",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudlane NestJS API",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "biome check src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate --schema src/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema src/prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema src/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema src/prisma/schema.prisma",
    "openapi:gen": "ts-node -e \"require('./scripts/gen-openapi.ts')\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1173.0",
    "@cloudlane/contracts": "workspace:*",
    "@nestjs/common": "10.4.6",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.6",
    "@nestjs/platform-express": "10.4.6",
    "@nestjs/schedule": "4.1.2",
    "@nestjs/swagger": "7.4.2",
    "@prisma/client": "5.22.0",
    "@types/multer": "^2.3.0",
    "argon2": "0.41.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "cookie-parser": "1.4.7",
    "cron-parser": "^4.9.0",
    "helmet": "8.0.0",
    "multer": "^2.5.0",
    "otplib": "12.0.1",
    "pg-boss": "10.1.5",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "uuid": "11.0.3"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.9",
    "@nestjs/testing": "10.4.6",
    "@types/cookie-parser": "1.4.7",
    "@types/express": "4.17.21",
    "@types/node": "22.9.0",
    "@types/uuid": "10.0.0",
    "prisma": "5.22.0",
    "supertest": "7.0.0",
    "ts-loader": "9.5.1",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.6.3",
    "vitest": "2.1.5"
  }
}
